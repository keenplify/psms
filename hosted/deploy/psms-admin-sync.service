[Unit]
Description=Refresh hosted pSMS admin entitlements from Singapore
After=psms-pg-tunnel.service
[Service]
Type=oneshot
User=psms_roles
Environment=PGPASSFILE=/etc/psms/role-sync/pgpass
ExecStart=/usr/bin/python3 /usr/local/lib/psms/sync-admins.py
TimeoutStartSec=40
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
