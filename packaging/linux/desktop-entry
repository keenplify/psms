#!/bin/sh
# Register the icon inside a user's graphical session, where the XDG desktop is known.
make_shortcut() {
    state=${XDG_STATE_HOME:-"$HOME/.local/state"}/papamo-sms
    [ ! -e "$state/desktop-shortcut-created" ] || return 0
    desktop=$(xdg-user-dir DESKTOP) || return 1
    [ -d "$desktop" ] && [ "$desktop" != "$HOME" ] || return 0
    mkdir -p "$state" || return 1
    xdg-desktop-icon install --novendor /usr/share/applications/dev.papamo.psms.desktop || return 1
    chmod u+x "$desktop/dev.papamo.psms.desktop" && touch "$state/desktop-shortcut-created"
}
make_shortcut
if [ "$1" = open ]; then exec /usr/bin/psms desktop; fi
