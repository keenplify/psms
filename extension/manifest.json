{
  "manifest_version": 3,
  "name": "pSMS Autofill",
  "version": "0.1.7",
  "description": "Fill a verification code from your own encrypted pSMS inbox.",
  "action": {"default_popup":"popup.html","default_title":"pSMS Autofill"},
  "permissions":["activeTab","scripting","storage"],
  "host_permissions":["http://127.0.0.1/*"],
  "optional_host_permissions":["https://*/*"],
  "background":{"service_worker":"background.js"},
  "icons":{"128":"icon.png"}
}
